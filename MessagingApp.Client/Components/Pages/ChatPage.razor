    async Task Send()
    {
        if (string.IsNullOrWhiteSpace(newMessage))
            return;

        if (selectedUser != null)
        {
            var msgText = newMessage;
            var now = DateTime.UtcNow;

            await Hub.SendMessageAsync(selectedUser.Id.ToString(), msgText);

            // 🔥 UPDATE SIDEBAR
            UpdateConversationPreview(
                selectedUser.Id,
                msgText,
                now
            );
        }
        else if (selectedGroup != null && selectedBot != null)
        {
            JS.InvokeVoidAsync("alert", "This feature is pending. \n🤖 Agents will be avaliable soon!");
        }
        else if (selectedGroup != null)
        {
            var msgText = newMessage;
            var now = DateTime.UtcNow;

            await Hub.SendGroupMessageAsync(
                selectedGroup.Id,
                Guid.Parse(currentUserId!),
                msgText
            );

            // 🔥 UPDATE SIDEBAR IMMEDIATELY
            UpdateGroupConversationPreview(
                selectedGroup.Id,
                msgText,
                now
            );
        }

        newMessage = "";
        StateHasChanged();
    }


    void OnMessageReceived(MessageDto msg)
    {
        var otherUserId =
            msg.SenderId.ToString() == currentUserId
                ? msg.ReceiverId
                : msg.SenderId;

        if (selectedUser != null && selectedUser.Id == otherUserId)
        {
            messages.Add(msg);
        }

        // 🔥 ALWAYS update sidebar
        UpdateConversationPreview(
            otherUserId,
            msg.Content,
            msg.CreatedAt
        );

        InvokeAsync(StateHasChanged);
    }

