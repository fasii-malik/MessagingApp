    private async Task ToggleStar(IEnumerable<Guid> messageIds)
    {
        try
        {
            // ToList() prevents "Collection Modified" errors if messageIds
            // is bound directly to your selection list
            var idsToUpdate = messageIds.ToList();

            foreach (var id in idsToUpdate)
            {
                await StarredMessageService.ToggleStarAsync(id);

                // Update UI locally
                var msg = messages.FirstOrDefault(m => m.Id == id);
                if (msg != null)
                    msg.IsStarred = !msg.IsStarred;
            }

            ToastService.ShowToast(new ToastOptions
                {
                    Title = "Success",
                    Text = "Update complete.",
                    RenderStyle = ToastRenderStyle.Success,
                    DisplayTime = TimeSpan.FromSeconds(3),
                    ThemeMode = ToastThemeMode.Pastel
                });
        }
        catch (Exception)
        {
            ToastService.ShowToast(new ToastOptions
                {
                    Title = "Error",
                    Text = "Something went wrong.",
                    RenderStyle = ToastRenderStyle.Danger,
                    DisplayTime = TimeSpan.FromSeconds(5),
                    ThemeMode = ToastThemeMode.Pastel
                });
        }
        finally
        {
            selectedMessageIds.Clear();
            isSelectionMode = false;

            if (showStarredMessages)
                starredMessages = await StarredMessageService.GetStarredMessagesAsync();

            StateHasChanged();
        }
    }





    public static string FormatMessageTime(DateTime sentAt)
    {
        var now = DateTime.Now;
        var sent = sentAt.ToLocalTime(); // make sure to convert from UTC if needed

        var diff = now.Date - sent.Date;

        if (diff.Days == 0)
        {
            // Today → show only time
            return sent.ToString("HH:mm"); // e.g., 14:35
        }
        else if (diff.Days == 1)
        {
            // Yesterday
            return "Yesterday";
        }
        else if (diff.Days < 7)
        {
            // Within last week → show day of the week
            return sent.ToString("dddd"); // e.g., Monday
        }
        else
        {
            // Older → show date
            return sent.ToString("dd/MM/yyyy"); // or "MMM dd, yyyy"
        }
    }
