        StateHasChanged();
    }

    private async Task LeaveGroup()
    {
        if (CurrentGroupId == null) return;

        bool confirmed = await DialogService.ConfirmAsync(new MessageBoxOptions()
            {
                Title = "Confirm Action",
                Text = "Are you sure you want to leave this group?",
                RenderStyle = MessageBoxRenderStyle.Warning,
                OkButtonText = "Leave",
                CancelButtonText = "Cancel"
            });

        if (!confirmed) return;

        var success = await GroupService.LeaveGroupAsync(CurrentGroupId.Value);

        if (success)
        {
            groups.RemoveAll(g => g.Id == CurrentGroupId);

            // 🔥 CLEAR CHAT STATE
            selectedGroup = null;
            CurrentGroupId = null;
            groupMessages.Clear();

            ToastService.ShowToast(new ToastOptions
                {
                    Title = "Group",
                    Text = "Left group successfully.",
                    RenderStyle = ToastRenderStyle.Success,
                    DisplayTime = TimeSpan.FromSeconds(5),
                    ThemeMode = ToastThemeMode.Pastel
                });

            StateHasChanged();
        }
    }

    private async Task DeleteConversation(Guid otherUserId)
    {
        bool confirmed = await DialogService.ConfirmAsync(new MessageBoxOptions()
            {
                Title = "Confirm Action",
                Text = "Are you sure you want to delete this conversation?",
                RenderStyle = MessageBoxRenderStyle.Warning,
                OkButtonText = "Delete",
                CancelButtonText = "Cancel"
            });

        if (!confirmed) return;

        var success = await MessageService.DeleteConversationAsync(otherUserId);
        if (success)
        {
            // Remove locally
            conversations.RemoveAll(c => c.UserId == otherUserId);
            StateHasChanged();

            ToastService.ShowToast(new ToastOptions
                {
                    Title = "Success!",
                    Text = "Conversation Deleted successfully.",
                    RenderStyle = ToastRenderStyle.Success,
                    DisplayTime = TimeSpan.FromSeconds(5),
                    ThemeMode = ToastThemeMode.Pastel
                });

            // Reset chat if this was selected
            if (selectedUser?.Id == otherUserId)
                selectedUser = null;
        }
    }

    private async Task Logout()
    {
        // 🔥 1. Disconnect SignalR
        await Hub.DisconnectAsync();

        // 2. Remove token
        await JS.InvokeVoidAsync("deleteCookie", "access_token");

        // 3. Update auth state
        if (AuthProvider is JWTAuthenticationStateProvider jwtAuth)
        {
            jwtAuth.MarkAsUnauthorize();
        }

        // 4. Redirect
        Nav.NavigateTo("/login", true);
    }

    async Task SelectGroup(GroupDto group)
    {
        // Leave previous group if any
        if (selectedGroup != null)
            await Hub.LeaveGroupAsync(selectedGroup.Id);

        selectedGroup = group;
        CurrentGroupId = group.Id;
        selectedUser = null;
        selectedConversation = null;
        showStarredMessages = false;
        selectedAgent = null;

        // Join the new group
        await Hub.JoinGroupAsync(group.Id);

        // Load existing messages
        groupMessages = await GroupMessageService.GetGroupMessagesAsync(group.Id);

        StateHasChanged();

        await JS.InvokeVoidAsync("scrollToBottom", "chatMessages");

        StateHasChanged();
    }

    private async Task TogglePin(ConversationDto convo)
    {
        bool success;

        if (convo.IsPinned)
            success = await MessageService.UnpinConversationAsync(convo.UserId);
        else
            success = await MessageService.PinConversationAsync(convo.UserId);

        if (!success)
            return;

        convo.IsPinned = !convo.IsPinned;

        // Optional: re-sort locally for instant UX
        conversations = conversations
            .OrderByDescending(c => c.IsPinned)
            .ThenByDescending(c => c.LastMessageTime)
            .ToList();
    }

    async Task ToggleGroupPin(GroupDto group)
    {
        if (group.IsPinned)
            await GroupService.UnpinGroupAsync(group.Id);
        else
            await GroupService.PinGroupAsync(group.Id);

        group.IsPinned = !group.IsPinned;

        groups = groups
            .OrderByDescending(g => g.IsPinned)
            .ThenByDescending(g => g.LastMessageTime ?? DateTime.MinValue)
            .ToList();
    }

    private async Task ShowStarredMessages()
    {
        selectedGroup = null;
        selectedUser = null;
        selectedAgent = null;

        // Load starred messages from your service
        starredMessages = await StarredMessageService.GetAllStarredMessagesAsync();
        foreach (var msg in messages)
        {
            msg.IsStarred = starredMessages.Any(s => s.MessageId == msg.Id);
        }

        showStarredMessages = true;

        StateHasChanged();
    }

    private void CloseStarredMessages()
    {
        showStarredMessages = false;
        selectedUser = null;
        selectedGroup = null;
    }

    private async Task ToggleStar(IEnumerable<StarredMessageDto> starredMessagesToUpdate)
    {
        try
        {
            var list = starredMessagesToUpdate.ToList();

            foreach (var item in list)
            {
                if (item.Type == "Group Message")
                {
                    await StarredMessageService.ToggleGroupStarAsync(item.MessageId);

                    var groupMsg = groupMessages.FirstOrDefault(m => m.Id == item.MessageId);
                    if (groupMsg != null)
                        groupMsg.IsStarred = !groupMsg.IsStarred;
                }
                else
                {
                    await StarredMessageService.ToggleStarAsync(item.MessageId);

                    var msg = messages.FirstOrDefault(m => m.Id == item.MessageId);
                    if (msg != null)
                        msg.IsStarred = !msg.IsStarred;
                }
            }

            ToastService.ShowToast(new ToastOptions
                {
                    Title = "Success",
                    Text = $"{list.Count} message(s) updated successfully.",
                    RenderStyle = ToastRenderStyle.Success,
                    DisplayTime = TimeSpan.FromSeconds(3),
                    ThemeMode = ToastThemeMode.Pastel
                });
        }
        catch
        {
            ToastService.ShowToast(new ToastOptions
                {
                    Title = "Error",
                    Text = "Something went wrong.",
                    RenderStyle = ToastRenderStyle.Danger,
                    DisplayTime = TimeSpan.FromSeconds(5),
                    ThemeMode = ToastThemeMode.Pastel
                });
        }
        finally
        {
            selectedMessageIds.Clear();
            isSelectionMode = false;

            if (showStarredMessages)
                starredMessages = await StarredMessageService.GetAllStarredMessagesAsync();

            StateHasChanged();
        }
    }

    //Helper method for StarredMessages
    private IEnumerable<StarredMessageDto> ResolveSelectedStarredMessages()
    {
        // ⭐ Starred Messages View
        if (showStarredMessages)
        {
            return starredMessages
                .Where(m => selectedMessageIds.Contains(m.MessageId));
        }

        // 👥 Group Chat View
        if (selectedGroup != null)
        {
            return groupMessages
                .Where(m => selectedMessageIds.Contains(m.Id))
                .Select(m => new StarredMessageDto
                    {
                        MessageId = m.Id,
                        Type = "Group Message"
                    });
        }

        // 👤 Private Chat View
        return messages
            .Where(m => selectedMessageIds.Contains(m.Id))
            .Select(m => new StarredMessageDto
                {
                    MessageId = m.Id,
                    Type = "Private Message"
                });
    }

