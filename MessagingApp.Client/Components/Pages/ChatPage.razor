@page "/chatpage"
@inject MessageService MessageService
@inject GroupMessageService GroupMessageService
@inject UserService UserService
@inject GroupService GroupService
@inject StarredMessageService StarredMessageService
@inject AgentService AgentService
@inject HttpClient Http
@inject JWTAuthenticationStateProvider AuthProvider
@inject ChatHubClient Hub
@inject NavigationManager Nav
@layout MessengerLayout
@inject IJSRuntime JS
@rendermode InteractiveServer
@using DevExpress.Blazor
@using MessagingApp.Client.Models.Agent
@inject IToastNotificationService ToastService
@inject IDialogService DialogService
@using Markdig

<link href="css/MessengerLayout.css" rel="stylesheet" />

<div class="custom-container @(selectedUser != null || selectedGroup != null || selectedAgent != null || showStarredMessages ? "chat-open" : "")">


    <div class="sidebar">
        <div class="sidebar">
            <!-- User Header -->
            <div class="user-header d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="user-avatar">
                        @CurrentUserInitials
                    </div>
                    <div class="user-info">
                        <h3>@(CurrentUser?.FullName ?? "Unknown")</h3>
                        <p>@(CurrentUser?.IsOnline == true ? "Online" : "Offline")</p>
                    </div>
                </div>

                <!-- THREE DOTS -->
                <div class="dropdown">
                    <button class="btn btn-sm btn-light border-0"
                            data-bs-toggle="dropdown">
                        ⋮
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" href="/">
                                <i class="bi bi-house"></i> Home
                            </a>
                        </li>
                        <li>
                            <a href="/create-group" class="dropdown-item">
                                <i class="bi bi-person-fill-add"></i> Create Group
                            </a>
                        </li>
                        <li>
                            <button class="dropdown-item text-warning" @onclick="ShowStarredMessages">
                                <i class="bi bi-star-fill"></i> Starred Messages
                            </button>

                        </li>
                        <li>
                            <button class="dropdown-item text-danger" @onclick="Logout">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </button>
                        </li>
                    </ul>
                </div>
            </div>

        </div>

        <div class="conversations-wrapper">

            <!-- MINI SIDEBAR -->
            <div class="mini-sidebar @(isMiniSidebarExpanded ? "expanded" : "collapsed")">

                <button class="mini-btn" @onclick="ToggleMiniSidebar">
                    ☰
                </button>

                <button class="mini-btn @(activeSection == SidebarSection.OnlineUsers ? "active" : "")"
                        @onclick="() => activeSection = SidebarSection.OnlineUsers">
                    👤
                    @if (isMiniSidebarExpanded)
                    {
                        <span>Online</span>
                    }
                </button>

                <button class="mini-btn @(activeSection == SidebarSection.Conversations ? "active" : "")"
                        @onclick="() => activeSection = SidebarSection.Conversations">
                    💬
                    @if (isMiniSidebarExpanded)
                    {
                        <span>Chats</span>
                    }
                </button>

                <button class="mini-btn @(activeSection == SidebarSection.Groups ? "active" : "")"
                        @onclick="() => activeSection = SidebarSection.Groups">
                    👥
                    @if (isMiniSidebarExpanded)
                    {
                        <span>Groups</span>
                    }
                </button>

                <button class="mini-btn @(activeSection == SidebarSection.Agents ? "active" : "")"
                        @onclick="() => activeSection = SidebarSection.Agents">
                    <i class="bi bi-robot"></i>
                    @if (isMiniSidebarExpanded)
                    {
                        <span>Ai Agents</span>
                    }
                </button>

            </div>


            <div class="conversations-list">

                @switch (activeSection)
                {
                    case SidebarSection.Conversations:
                        <!-- CONVERSATIONS LIST -->
                        @if (conversations == null || !conversations.Any())
                        {
                            <p class="text-muted px-2 text-center">No conversations yet</p>
                        }
                        else
                        {
                            <div class="search-container">
                                <input type="text"
                                       class="search-box"
                                       placeholder="Search conversations..."
                                       @bind="searchText"
                                       @bind:event="oninput" />
                            </div>


                            @foreach (var convo in FilteredConversations)
                            {
                                <div class="conversation-item @(selectedUser?.Id == convo.UserId ? "active" : "")"
                                     @onclick="() => SelectConversation(convo)">
                                    <!-- Avatar (initials) -->
                                    <div class="conversation-avatar">
                                        @(convo.FullName.Split(' ').Select(n => n[0]).FirstOrDefault())
                                    </div>

                                    <!-- Conversation details -->
                                    <div class="conversation-details">
                                        <div class="conversation-header">
                                            <span class="conversation-name">@convo.FullName</span>
                                            <span class="conversation-time"> @FormatMessageTime(@convo.LastMessageTime)</span>
                                            <!-- PIN BUTTON -->
                                            <button class="btn btn-sm btn-light border-0 p-0"
                                                    title="Pin"
                                                    @onclick="() => TogglePin(convo)"
                                            @onclick:stopPropagation>
                                                @(convo.IsPinned ? "📌" : "📍")
                                            </button>
                                        </div>
                                        <div class="conversation-preview">
                                            @convo.LastMessage
                                        </div>
                                    </div>


                                    <!-- DROPDOWN -->
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border-0"
                                                data-bs-toggle="dropdown"
                                        @onclick:stopPropagation>
                                            ⋮
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <button class="dropdown-item text-danger"
                                                        @onclick="() => DeleteConversation(convo.UserId)">
                                                    🗑 Delete
                                                </button>
                                            </li>
                                        </ul>
                                    </div>

                                    <!-- Unread messages badge -->
                                    @if (convo.UnreadCount > 0)
                                    {
                                        <div class="unread-badge">@convo.UnreadCount</div>
                                    }
                                </div>
                            }
                        }
                        break;

                    case SidebarSection.OnlineUsers:

                        <div class="px-2">

                            <!-- ONLINE USERS -->
                            <div class="mb-3">


                                <p class="text-muted small text-center">New Conversation</p>

                                @foreach (var user in users.Where(u => u.IsOnline))
                                {
                                    <div class="conversation-item @(selectedUser?.Id == user.Id ? "active" : "")"
                                         @onclick="() => SelectUser(user)">

                                        <div class="conversation-avatar">
                                            @user.FullName[0]
                                        </div>

                                        <div class="conversation-details">
                                            <div class="conversation-users-wrapper">
                                                <span class="conversation-name">@user.FullName</span>
                                                <small class="online-dot">.</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @* } *@
                            </div>

                            <!-- OFFLINE USERS -->
                            <div>

                                @foreach (var user in users.Where(u => !u.IsOnline))
                                {
                                    <div class="conversation-item text-muted @(selectedUser?.Id == user.Id ? "active" : "")"
                                         @onclick="() => SelectUser(user)">

                                        <div class="conversation-avatar">
                                            @user.FullName[0]
                                        </div>

                                        <div class="conversation-details">
                                            <div class="conversation-users-wrapper">
                                                <span class="conversation-name">@user.FullName</span>
                                                <small class="offline-dot">.</small>
                                            </div>

                                        </div>
                                    </div>
                                }
                            </div>

                        </div>

                        break;

                    case SidebarSection.Groups:
                        <div class="px-2">

                            @if (groups.Count == 0)
                            {
                                <p class="text-muted small text-center">No groups yet 🚧</p>
                            }
                            else
                            {
                                @foreach (var group in groups)
                                {
                                    <div class="conversation-item @(CurrentGroupId == group.Id ? "active" : "")"
                                         @onclick="() => SelectGroup(group)">

                                        <!-- Avatar -->
                                        <div class="conversation-avatar">
                                            @(group.Name.Split(' ').Select(n => n[0]).FirstOrDefault())
                                        </div>

                                        <!-- Details -->
                                        <div class="conversation-details">
                                            <div class="conversation-header">
                                                <span class="conversation-name">@group.Name</span>

                                                @if (group.LastMessageTime != null)
                                                {
                                                    <span class="conversation-time">
                                                        @FormatMessageTime(@group.LastMessageTime.Value)
                                                    </span>
                                                }

                                                <button class="btn btn-sm btn-light border-0 p-0"
                                                        @onclick="() => ToggleGroupPin(group)"
                                                @onclick:stopPropagation>
                                                    @(group.IsPinned ? "📌" : "📍")
                                                </button>

                                            </div>

                                            <div class="conversation-preview">
                                                @(!string.IsNullOrEmpty(group.LastMessage)
                                                    ? group.LastMessage
                                                    : "No messages yet")
                                            </div>

                                            <small class="text-muted small opacity-75">
                                                @group.MembersCount members
                                            </small>

                                        </div>

                                        <!-- DROPDOWN -->
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-light border-0"
                                                    data-bs-toggle="dropdown"
                                                    @onclick:stopPropagation="true">
                                                ⋮
                                            </button>

                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <button class="dropdown-item"
                                                            @onclick="() => OpenGroupInfo(group)">
                                                        👥 Group Info
                                                    </button>

                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                }
                            }
                        </div>
                        break;

                    case SidebarSection.Agents:
                        <div class="px-2">
                            @if (agents != null)
                            {
                                @foreach (var agent in agents)
                                {
                                    <div class="conversation-item @(selectedAgent?.Id == agent.Id ? "active" : "")"
                                         @onclick="() => OpenAgentChat(agent)">

                                        <div class="conversation-avatar">
                                            <i class="bi bi-chat-dots-fill"></i>
                                        </div>
                                        <div class="conversation-details">
                                            <div class="conversation-header">
                                                <span>@agent.Name</span>
                                                <span class="text-muted small">Now</span>
                                            </div>
                                            <div class="conversation-preview">
                                                Hello! How can I help you today?
                                            </div>
                                        </div>
                                        <div class="dropdown" @onclick:stopPropagation="true">
                                            <button class="btn btn-sm btn-light border-0" data-bs-toggle="dropdown">
                                                ⋮
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li><button class="dropdown-item">Ai Agent Info</button></li>
                                            </ul>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center p-3 text-muted">
                                    Loading agents...
                                </div>
                            }
                        </div>

                        break;

                }

            </div>


        </div>

    </div>

    @if (loading)
    {
        <p class="mt-5 text-center">Loading...</p>
    }
    else if (!string.IsNullOrEmpty(initError))
    {
        <p style="color:red">@initError</p>
    }
    else
    {

        <div class="d-flex flex-column h-100" style="width:100%">
            @* message selection buttons   *@

            @if (isSelectionMode)
            {
                <div class="d-flex justify-content-end align-items-center gap-2 bg-light">
                    <span class="text-muted small mt-1">
                        @selectedMessageIds.Count selected
                    </span>



                    @if (selectedMessageIds.Any())
                    {
                        <button class="btn btn-sm btn-outline-warning bg-transparent" @onclick="() => ToggleStar(ResolveSelectedStarredMessages())">
                            @{
                                // Check if the first selected message is already starred to decide the icon
                                var firstId = selectedMessageIds.First();
                                var isFirstStarred = messages.FirstOrDefault(m => m.Id == firstId)?.IsStarred ?? false;
                            }
                            <i class="bi @(isFirstStarred ? "bi-star-fill text-warning" : "bi-star")"></i>
                        </button>
                    }


                    <button class="btn btn-outline-danger btn-sm mt-1 mb-1"
                            disabled="@(!selectedMessageIds.Any())"
                            @onclick="DeleteSelectedMessages">
                        🗑 Delete
                    </button>

                    <button class="btn btn-sm btn-outline-primary mt-1 mb-1 me-1"
                            @onclick="ClearSelection">
                        ✖ Cancel
                    </button>
                </div>
            }

            @* This is group info ui Start.......................... *@
            @if (showGroupInfo)
            {
                <!-- Overlay (Click to close) -->
                <div class="overlay active"></div>

                <div class="group-info-panel open">
                    <!-- Header -->
                    <div class="group-info-header">
                        <h5>Group Info</h5>
                        <button class="close-btn" @onclick="() => showGroupInfo = false">✖</button>
                    </div>

                    <!-- Group Avatar & Name -->
                    <div class="group-avatar-section">
                        <div class="group-avatar-large">
                            @groupInfo.Name.Substring(0, Math.Min(3, groupInfo.Name.Length)).ToUpper()
                        </div>
                        <div class="group-name">@groupInfo.Name</div>
                        <div class="group-created">
                            Created on @groupInfo.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                        </div>
                    </div>

                    <!-- Body Content -->
                    <div class="group-info-body">
                        <!-- Stats -->
                        <div class="info-section">
                            <div class="group-stats">
                                <div class="stat-card">
                                    <span class="stat-number">@groupInfo.MembersCount</span>
                                    <span class="stat-label">Members</span>
                                </div>
                                <!-- You can fetch total messages if needed -->
                                <div class="stat-card">
                                    <span class="stat-number">@groupInfo.MessagesCount</span>
                                    <span class="stat-label">Messages</span>
                                </div>
                            </div>
                        </div>

                        <!-- Members -->
                        <div class="info-section">
                            <div class="section-header">
                                <span class="section-title">Members</span>
                                <span class="member-count">@groupInfo.Members.Count</span>
                            </div>
                            <ul class="member-list">
                                @foreach (var member in groupInfo.Members)
                                {
                                    <li class="member-item">
                                        <div class="avatar">
                                            @member.Username.Substring(0, 2).ToUpper() <!-- or use actual initials -->
                                        </div>
                                        <div class="member-details">
                                            <span class="member-name">@member.Username</span> <!-- Replace with actual username if you have it -->
                                            <span class="member-role">@((member.IsAdmin) ? "Group Admin" : "Member")</span>
                                        </div>
                                        @if (member.IsAdmin)
                                        {
                                            <span class="admin-badge">Admin</span>
                                        }
                                        else
                                        {
                                            <!-- Online / Offline indicator -->
                                            <div class=" @(member.IsOnline ? "online-indicator" : "Offline")"></div>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="action-buttons">
                        <button type="button" class="action-btn btn-add-member"
                                @onclick="OpenAddMemberModal">
                            <span>➕</span> Add Member
                        </button>

                        <button class="action-btn btn-leave"
                                @onclick="LeaveGroup">
                            <span>🚪</span> Leave
                        </button>
                    </div>
                </div>

                <!-- end group-info-panel -->
                @if (showAddMemberModal)
                {
                    <div class="modal-backdrop" @onclick="() => showAddMemberModal = false"></div>

                    <div class="add-member-modal">
                        <h4>Add member</h4>

                        @if (!users.Any(u => !groupInfo.Members.Any(m => m.UserId == u.Id)))
                        {
                            <p class="text-muted">All users are already members 🎉</p>
                        }
                        else
                        {
                            <select @bind="selectedUserId">
                                @foreach (var user in users
                               .Where(u => !groupInfo.Members.Any(m => m.UserId == u.Id)))
                                {
                                    <option value="@user.Id">@user.FullName</option>
                                }
                            </select>
                        }


                        <div class="modal-actions">
                            <button type="button" @onclick="AddMember">Add</button>
                            <button type="button" @onclick="() => showAddMemberModal = false">Cancel</button>
                        </div>
                    </div>
                }

            }
            @* This is group info ui End.......................... *@

            <!-- CHAT AREA -->
            <!-- MAIN CONTENT -->
            <div class="flex-grow-1 d-flex align-items-center justify-content-center bg-light">


                @if (selectedUser == null && selectedGroup == null && showStarredMessages == false && selectedAgent == null)
                {
                    <!-- EMPTY STATE -->
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center py-5">
                        <div class="bg-light rounded-circle p-4">
                            <i class="bi bi-chat-dots text-primary" style="font-size: 3rem;"></i>
                        </div>
                        <h2 class="fw-bold">Your Messages</h2>
                        <p class="text-muted mb-4" style="max-width: 250px;">
                            Select a conversation from the sidebar to start chatting with your friends or groups.
                        </p>
                        <button class="btn btn-outline-primary btn-sm rounded-pill px-4
                            @(activeSection == SidebarSection.OnlineUsers ? "active" : "")"
                                @onclick="() => activeSection = SidebarSection.OnlineUsers">
                            <i class="bi bi-plus-lg me-2"></i>New Conversation
                        </button>
                    </div>


                }
                else
                {
                    <!-- CHAT AREA -->
                    <div class="bg-white border rounded p-3 d-flex flex-column chat-container">

                        <button class="btn btn-sm btn-light d-md-none"
                                @onclick="() => { selectedUser = null; selectedGroup = null;
                                    showStarredMessages = false;}">
                            ← Back
                        </button>
                        @* ================= USER CHAT ================= *@
                        @if (selectedUser != null)
                        {
                            <!-- HEADER -->
                            <div class="chat-header-fancy">
                                <div class="chat-user-avatar user-chat-avatar">
                                    @(selectedUser.FullName.Split(' ').Select(n => n[0]).FirstOrDefault())
                                </div>
                                <div>
                                    <h5 class="mb-0">@selectedUser.FullName</h5>
                                    <small class="text-muted d-flex align-items-center gap-1">
                                        <span class="status-dot @(selectedUser.IsOnline ? "online" : "offline")"></span>
                                        @(selectedUser.IsOnline ? "Online" : "Offline")
                                    </small>
                                    @if (typingUserId != null)
                                    {
                                        <div>
                                            <small class="typing-indicator text-muted">
                                                <span class="typing-dot"></span>
                                                <span class="typing-dot"></span>
                                                <span class="typing-dot"></span>
                                                typing...
                                            </small>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- MESSAGES -->
                            <div id="chatMessages" class="flex-grow-1 border rounded p-2 mb-2 overflow-auto user-chat-messages">
                                @foreach (var msg in messages)
                                {
                                    var isSent = msg.SenderId.ToString() == currentUserId;
                                    var isSelected = selectedMessageIds.Contains(msg.Id);

                                    <div class="message-wrapper @(isSent ? "sent-wrap" : "received-wrap user-message-wrap")"
                                         @onclick="() => OnMessageClick(msg.Id)">

                                        @if (!isSent)
                                        {
                                            <!-- User Avatar -->
                                            <div class="user-message-avatar">
                                                @(selectedUser.FullName.Split(' ').Select(n => n[0]).FirstOrDefault())
                                            </div>
                                        }

                                        <div class="chat-message @(isSent ? "sent user-sent-message" : "received user-received-message") @(isSelected ? "selected" : "")">
                                            @if (!isSent)
                                            {
                                                <div class="message-sender-name">@selectedUser.FullName</div>
                                            }

                                            <div class="message-content @(isSent ? "sent-content" : "received-content")">
                                                @msg.Content
                                            </div>

                                            <div class="message-time">
                                                @msg.CreatedAt.ToLocalTime().ToString("HH:mm")
                                            </div>

                                            @if (isSelected)
                                            {
                                                <span class="selection-tick">✔</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @* ================= GROUP CHAT ================= *@
                        else if (selectedGroup != null)
                        {
                            <!-- HEADER -->
                            <div class="chat-header-fancy group-chat-header">
                                <div class="chat-user-avatar group-avatar">
                                    @(selectedGroup.Name.Split(' ').Select(n => n[0]).FirstOrDefault())
                                </div>
                                <div>
                                    <small class="text-muted d-flex align-items-center gap-1">
                                        <i class="bi bi-people-fill"></i> Group
                                    </small>
                                    <h5 class="mb-0">@selectedGroup.Name</h5>
                                    <small class="text-muted">
                                        @selectedGroup.MembersCount members
                                    </small>
                                </div>
                            </div>

                            <!-- MESSAGES -->
                            <div id="chatMessages" class="flex-grow-1 border rounded p-2 mb-2 overflow-auto group-chat-messages">
                                @foreach (var msg in groupMessages)
                                {
                                    var isSent = msg.SenderId.ToString() == currentUserId;
                                    var isSelected = selectedMessageIds.Contains(msg.Id);
                                    var senderName = isSent ? "You" : GetUserName(msg.SenderId);
                                    var senderInitial = senderName.FirstOrDefault();

                                    <div class="message-wrapper @(isSent ? "sent-wrap" : "received-wrap group-message-wrap")"
                                         @onclick="() => OnMessageClick(msg.Id)">

                                        @if (!isSent)
                                        {
                                            <!-- Group Member Avatar -->
                                            <div class="group-member-avatar">
                                                @senderInitial
                                            </div>
                                        }

                                        <div class="chat-message @(isSent ? "sent group-sent-message" : "received group-received-message") @(isSelected ? "selected" : "")">
                                            @if (!isSent)
                                            {
                                                <div class="message-sender-name group-sender">@senderName</div>
                                            }

                                            <div class="message-content @(isSent ? "sent-content" : "received-content")">
                                                @msg.Content
                                            </div>

                                            <div class="message-time">
                                                @msg.SentAt.ToLocalTime().ToString("HH:mm")
                                            </div>

                                            @if (isSelected)
                                            {
                                                <span class="selection-tick">✔</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else if (showStarredMessages)
                        {

                            <div class="starred-messages-panel border rounded p-3 mb-2 bg-light">
                                <div class="d-flex justify-content-between mb-2">
                                    <strong>⭐ Starred Messages</strong>
                                    <button class="btn btn-sm btn-light" @onclick="CloseStarredMessages">✖</button>
                                </div>

                                <div class="starred-messages-list">
                                    @if (starredMessages.Any())
                                    {
                                        @foreach (var msg in starredMessages)
                                        {
                                            <div class="starred-message d-flex flex-column gap-1 mb-1 p-2 border rounded">

                                                <!-- Metadata line: time, sender, type + Star button -->
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <!-- Left side: metadata -->
                                                    <div class="d-flex align-items-center gap-3">
                                                        <span class="text-muted small">@FormatMessageTime(msg.StarredAtUtc)</span>
                                                        <span class="text-muted small">@msg.Fullname</span>
                                                        <span class="text-muted small">@msg.Type</span>
                                                    </div>

                                                    <!-- Right side: Unstar button -->
                                                    <button class="btn btn-sm btn-outline-warning"
                                                            title="Unstar"
                                                            type="button"
                                                            @onclick="() => ToggleStar(new[] { msg })">
                                                        <i class="bi bi-star-fill"></i>
                                                    </button>
                                                </div>

                                                <!-- Message content -->
                                                <div class="p-1">@msg.Content</div>

                                            </div>



                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted small">No starred messages</p>
                                    }
                                </div>
                            </div>
                        }
                        else if (selectedAgent != null)
                        {
                            <!-- HEADER -->
                            <div class="chat-header-fancy">
                                <div class="chat-user-avatar agent-avatar">
                                    <i class="bi bi-robot"></i>
                                </div>
                                <div>
                                    <h5 class="mb-0">@selectedAgent.Name</h5>
                                    <small class="text-muted">AI Assistant</small>

                                    @if (typingUserId != null && typingUserId == selectedAgent.Id.ToString())
                                    {
                                        <div>
                                            <small class="typing-indicator text-muted">
                                                typing...
                                            </small>
