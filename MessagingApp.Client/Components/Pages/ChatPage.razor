        }
    }
    private string FormatAgentMessage(string content)
    {
        if (string.IsNullOrEmpty(content))
            return content;

        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();

        return Markdig.Markdown.ToHtml(content, pipeline);
    }

    private async Task HandleAttachment(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;

            // Check file size
            if (file.Size > maxFileSize)
            {
                ToastService.ShowToast(new ToastOptions
                    {
                        Title = "File Too Large",
                        Text = $"File size must be less than {maxFileSize / (1024 * 1024)}MB",
                        RenderStyle = ToastRenderStyle.Warning,
                        DisplayTime = TimeSpan.FromSeconds(3),
                        ThemeMode = ToastThemeMode.Pastel
                    });
                return;
            }

            attachedFile = file;

            ToastService.ShowToast(new ToastOptions
                {
                    Title = "File Attached",
                    Text = $"{file.Name} attached successfully",
                    RenderStyle = ToastRenderStyle.Success,
                    DisplayTime = TimeSpan.FromSeconds(2),
                    ThemeMode = ToastThemeMode.Pastel
                });

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.ShowToast(new ToastOptions
                {
                    Title = "Error",
                    Text = "Failed to attach file",
                    RenderStyle = ToastRenderStyle.Danger,
                    DisplayTime = TimeSpan.FromSeconds(3),
                    ThemeMode = ToastThemeMode.Pastel
                });
        }
    }

    private void RemoveAttachment()
    {
        attachedFile = null;
        StateHasChanged();
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;

        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }

        return $"{len:0.##} {sizes[order]}";
    }
