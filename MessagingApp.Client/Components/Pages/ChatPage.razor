@page "/chatpage"
@inject MessageService MessageService
@inject GroupMessageService GroupMessageService
@inject UserService UserService
@inject GroupService GroupService
@inject HttpClient Http
@inject JWTAuthenticationStateProvider AuthProvider
@inject ChatHubClient Hub
@inject NavigationManager Nav
@layout MessengerLayout
@inject IJSRuntime JS
@rendermode InteractiveServer
@using DevExpress.Blazor
@inject IToastNotificationService ToastService
@inject IDialogService DialogService

<style>

    /* Overlay Background */
    .overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.4);
        z-index: 998;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }

        .overlay.active {
            opacity: 1;
            visibility: visible;
        }

    /* Panel Styles */
    .group-info-panel {
        position: fixed;
        top: 0;
        right: -400px;
        width: 450px;
        height: 100vh;
        background: white;
        box-shadow: -4px 0 20px rgba(0, 0, 0, 0.15);
        overflow-y: auto;
        z-index: 999;
        transition: right 0.3s ease;
    }

        .group-info-panel.open {
            right: 0;
        }

    @@keyframes slideIn {
        from {
            right: -400px;
        }

        to {
            right: 0;
        }
    }

    .group-info-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .group-info-header h5 {
            font-size: 18px;
            font-weight: 600;
        }

    .close-btn {
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: white;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

        .close-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: rotate(90deg);
        }

    .group-avatar-section {
        text-align: center;
        padding: 30px 20px;
        background: linear-gradient(to bottom, rgba(102, 126, 234, 0.1), white);
    }

    .group-avatar-large {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 42px;
        font-weight: bold;
        margin: 0 auto 15px;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }

    .group-name {
        font-size: 20px;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 5px;
    }

    .group-created {
        font-size: 13px;
        color: #65676b;
    }

    .group-info-body {
        padding: 20px;
    }

    .info-section {
        margin-bottom: 25px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .section-title {
        font-size: 13px;
        font-weight: 600;
        color: #65676b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .member-count {
        background: rgba(102, 126, 234, 0.1);
        color: #667eea;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
    }

    .group-description {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 10px;
        color: #2c3e50;
        font-size: 14px;
        line-height: 1.5;
        border-left: 3px solid #667eea;
    }

    .member-list {
        list-style: none;
        max-height: 300px;
        overflow-y: auto;
    }

        .member-list::-webkit-scrollbar {
            width: 6px;
        }

        .member-list::-webkit-scrollbar-track {
            background: transparent;
        }

        .member-list::-webkit-scrollbar-thumb {
            background: #667eea;
            border-radius: 3px;
        }

    .member-item {
        display: flex;
        align-items: center;
        padding: 12px;
        border-radius: 10px;
        transition: all 0.2s ease;
        cursor: pointer;
        margin-bottom: 5px;
    }

        .member-item:hover {
            background: rgba(102, 126, 234, 0.05);
        }

    .avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 16px;
        margin-right: 12px;
        flex-shrink: 0;
    }

    .member-details {
        flex: 1;
    }

    .member-name {
        font-weight: 500;
        color: #2c3e50;
        font-size: 15px;
        display: block;
    }

    .member-role {
        font-size: 12px;
        color: #65676b;
        margin-top: 2px;
    }

    .admin-badge {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 3px 8px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
    }

    .online-indicator {
        width: 10px;
        height: 10px;
        background: #10b981;
        border-radius: 50%;
        border: 2px solid white;
        position: relative;
        margin-left: auto;
    }

    .action-buttons {
        display: flex;
        gap: 10px;
        padding: 0 20px 20px;
    }

    .action-btn {
        flex: 1;
        padding: 12px;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .btn-add-member {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

        .btn-add-member:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }

    .btn-leave {
        background: #f0f2f5;
        color: #ff4757;
    }

        .btn-leave:hover {
            background: #fee;
        }

    .group-stats {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

    .stat-card {
        flex: 1;
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
        padding: 15px;
        border-radius: 10px;
        text-align: center;
    }

    .stat-number {
        font-size: 24px;
        font-weight: bold;
        color: #667eea;
        display: block;
    }

    .stat-label {
        font-size: 12px;
        color: #65676b;
        margin-top: 5px;
    }


    /* Test CSS - Put chat styles here temporarily */
    .chat-container {
        background: rgba(255, 255, 255, 0.85) !important;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        height: 93%;
        width: 93%;
    }

    .chat-message {
        padding: 10px 14px;
        margin-bottom: 12px !important;
        border-radius: 18px;
    }

        .chat-message.sent {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
            margin-left: auto;
            max-width: 300px;
        }

        .chat-message.received {
            background: lightgrey;
            margin-right: auto;
            max-width: 300px;
        }
    /* Send Button */
    .chat-send-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none !important;
        border-radius: 8px !important;
        padding: 10px 24px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
    }

        .chat-send-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(52, 152, 219, 0.4);
            background: linear-gradient(135deg, #2980b9 0%, #3498db 100%) !important;
        }

        .chat-send-btn:active {
            transform: translateY(0);
        }

    /* Input Area */
    .chat-input-area {
        gap: 12px !important;
    }

    /* Input Field */
    .chat-input {
        background: rgba(255, 255, 255, 0.8) !important;
        border: 1px solid rgba(52, 152, 219, 0.3) !important;
        border-radius: 8px !important;
        padding: 10px 16px;
        transition: all 0.3s ease;
    }

        .chat-input:focus {
            background: rgba(255, 255, 255, 0.95) !important;
            border-color: #3498db !important;
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1) !important;
            outline: none;
        }

        .chat-input::placeholder {
            color: rgba(108, 117, 125, 0.6);
        }

    .chat-header-fancy {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px;
        border-bottom: 2px solid rgba(52, 152, 219, 0.3);
        margin-bottom: 16px;
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
        border-radius: 8px;
    }

    .chat-user-avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 18px;
    }

    .chat-header-fancy h5 {
        font-size: 16px;
        font-weight: 600;
        color: #2c3e50;
        margin: 0;
    }

    .chat-header-fancy small {
        font-size: 12px;
    }

    .conversations-wrapper {
        display: flex;
        height: 100%;
    }

    /* Mini sidebar */
    .mini-sidebar {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(8px);
        border-right: 1px solid rgba(0,0,0,0.05);
        transition: width 0.3s ease;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 8px 4px;
    }

        .mini-sidebar.collapsed {
            width: 48px;
        }

        .mini-sidebar.expanded {
            width: 140px;
            align-items: flex-start;
            padding-left: 12px;
        }

    /* Buttons */
    .mini-btn {
        background: transparent;
        border: none;
        width: 100%;
        padding: 10px;
        margin-bottom: 6px;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 500;
        color: #2c3e50;
    }

        .mini-btn:hover {
            background: rgba(52, 152, 219, 0.12);
        }

        .mini-btn.active {
            background: rgba(52, 152, 219, 0.2);
        }

    .message-wrapper {
        display: flex;
        margin-bottom: 10px;
        cursor: pointer;
    }

    .sent-wrap {
        justify-content: flex-end;
    }

    .received-wrap {
        justify-content: flex-start;
    }

    .chat-message {
        position: relative;
        padding: 10px 14px;
        border-radius: 18px;
        max-width: 300px;
    }

        /* Selection highlight */
        .chat-message.selected {
            background-color: rgba(52, 152, 219, 0.15) !important;
            border: 1px solid rgba(52, 152, 219, 0.6);
        }

    /* Blue tick */
    .selection-tick {
        position: absolute;
        bottom: -6px;
        right: -6px;
        width: 20px;
        height: 20px;
        background: #3498db;
        color: white;
        font-size: 12px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 6px rgba(0,0,0,0.25);
    }

    /*Add member section css*/
    /* Enhanced Add Member Modal Styles */
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        z-index: 999;
        animation: fadeIn 0.2s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .add-member-modal {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: white;
        padding: 0;
        width: 420px;
        max-width: 90vw;
        border-radius: 16px;
        z-index: 1000;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        animation: slideUp 0.3s ease;
        overflow: hidden;
    }

    @@keyframes slideUp {
        from {
            transform: translate(-50%, -45%);
            opacity: 0;
        }

        to {
            transform: translate(-50%, -50%);
            opacity: 1;
        }
    }

    .add-member-modal h4 {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 24px;
        margin: 0;
        font-size: 20px;
        font-weight: 600;
    }

    .add-member-modal select {
        width: 100%;
        padding: 14px 16px;
        margin: 15px 24px 20px 24px;
        width: calc(100% - 48px);
        border: 2px solid #e4e6eb;
        border-radius: 10px;
        font-size: 15px;
        background: white;
        cursor: pointer;
        transition: all 0.3s ease;
        appearance: none;
        background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='%23667eea' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 16px center;
        padding-right: 45px;
    }

        .add-member-modal select:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .add-member-modal select:hover {
            border-color: #667eea;
        }

    .modal-actions {
        display: flex;
        gap: 12px;
        padding: 0 24px 24px;
    }

        .modal-actions button {
            flex: 1;
            padding: 14px 24px;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .modal-actions button:first-child {
                background: #f0f2f5;
                color: #65676b;
            }

                .modal-actions button:first-child:hover {
                    background: #e4e6eb;
                }

            .modal-actions button:last-child {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
            }

                .modal-actions button:last-child:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);
                }

                .modal-actions button:last-child:active {
                    transform: translateY(0);
                }


    @@media (max-width: 768px) {
        /* Hide sidebar when chat is open */
        .chat-open .sidebar {
            display: none;
        }
        /* Show chat full screen */
        .chat-open .chat-container {
            display: flex;
        }

        .group-info-panel {
            width: 100%;
        }

        .chat-container {
            height: 100%;
            width: 100%;
        }
    }

</style>

<link href="css/MessengerLayout.css" rel="stylesheet" />

<div class="custom-container @(selectedUser != null || selectedGroup != null ? "chat-open" : "")">


    <div class="sidebar">
        <div class="sidebar">
            <!-- User Header -->
            <div class="user-header d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="user-avatar">
                        @CurrentUserInitials
                    </div>
                    <div class="user-info">
                        <h3>@(CurrentUser?.FullName ?? "Unknown")</h3>
                        <p>@(CurrentUser?.IsOnline == true ? "Online" : "Offline")</p>
                    </div>
                </div>

                <!-- THREE DOTS -->
                <div class="dropdown">
                    <button class="btn btn-sm btn-light border-0"
                            data-bs-toggle="dropdown">
                        ⋮
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" href="/">
                                <i class="bi bi-house"></i> Home
                            </a>
                        </li>
                        <li>
                            <a href="/create-group" class="dropdown-item">
                                <i class="bi bi-person-fill-add"></i> Create Group
                            </a>
                        </li>
                        <li>
                            <button class="dropdown-item text-danger" @onclick="Logout">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </button>
                        </li>
                    </ul>
                </div>
            </div>

        </div>

        <div class="conversations-wrapper">

            <!-- MINI SIDEBAR -->
            <div class="mini-sidebar @(isMiniSidebarExpanded ? "expanded" : "collapsed")">

                <button class="mini-btn" @onclick="ToggleMiniSidebar">
                    ☰
                </button>

                <button class="mini-btn @(activeSection == SidebarSection.OnlineUsers ? "active" : "")"
                        @onclick="() => activeSection = SidebarSection.OnlineUsers">
                    👤
                    @if (isMiniSidebarExpanded)
                    {
                        <span>Online</span>
                    }
                </button>

                <button class="mini-btn @(activeSection == SidebarSection.Conversations ? "active" : "")"
                        @onclick="() => activeSection = SidebarSection.Conversations">
                    💬
                    @if (isMiniSidebarExpanded)
                    {
                        <span>Chats</span>
                    }
                </button>

                <button class="mini-btn @(activeSection == SidebarSection.Groups ? "active" : "")"
                        @onclick="() => activeSection = SidebarSection.Groups">
                    👥
                    @if (isMiniSidebarExpanded)
                    {
                        <span>Groups</span>
                    }
                </button>

            </div>


            <div class="conversations-list">

                @switch (activeSection)
                {
                    case SidebarSection.Conversations:
                        <!-- CONVERSATIONS LIST -->
                        @if (conversations == null || !conversations.Any())
                        {
                            <p class="text-muted px-2 text-center">No conversations yet</p>
                        }
                        else
                        {
                            <!-- Search Bar -->
                            <div class="search-container">
                                <input type="text" class="search-box" placeholder="Search conversations...">
                            </div>
                            @foreach (var convo in conversations)
                            {
                                <div class="conversation-item @(selectedUser?.Id == convo.UserId ? "active" : "")"
                                     @onclick="() => SelectConversation(convo)">
                                    <!-- Avatar (initials) -->
                                    <div class="conversation-avatar">
                                        @(convo.FullName.Split(' ').Select(n => n[0]).FirstOrDefault())
                                    </div>

                                    <!-- Conversation details -->
                                    <div class="conversation-details">
                                        <div class="conversation-header">
                                            <span class="conversation-name">@convo.FullName</span>
                                            <span class="conversation-time"> @FormatMessageTime(@convo.LastMessageTime)</span>
                                        </div>
                                        <div class="conversation-preview">
                                            @convo.LastMessage
                                        </div>
                                    </div>


                                    <!-- DROPDOWN -->
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border-0"
                                                data-bs-toggle="dropdown"
                                                @onclick:stopPropagation>
                                            ⋮
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <button class="dropdown-item text-danger"
                                                        @onclick="() => DeleteConversation(convo.UserId)">
                                                    🗑 Delete
                                                </button>
                                            </li>
                                        </ul>
                                    </div>

                                    <!-- Unread messages badge -->
                                    @if (convo.UnreadCount > 0)
                                    {
                                        <div class="unread-badge">@convo.UnreadCount</div>
                                    }
                                </div>
                            }
                        }
                        break;

                    case SidebarSection.OnlineUsers:

                        <div class="px-2">

                            <!-- ONLINE USERS -->
                            <div class="mb-3">

                                @* @if (!users.Any(u => u.IsOnline))
                        { *@
                                <p class="text-muted small text-center">New Conversation</p>
                                @* }
                        else
                        { *@
                                @foreach (var user in users.Where(u => u.IsOnline))
                                {
                                    <div class="conversation-item @(selectedUser?.Id == user.Id ? "active" : "")"
                                         @onclick="() => SelectUser(user)">

                                        <div class="conversation-avatar">
                                            @user.FullName[0]
                                        </div>

                                        <div class="conversation-details">
                                            <span class="conversation-name">@user.FullName</span>
                                            <small class="text-success">Online</small>
                                        </div>
                                    </div>
                                }
                                @* } *@
                            </div>

                            <!-- OFFLINE USERS -->
                            <div>

                                @foreach (var user in users.Where(u => !u.IsOnline))
                                {
                                    <div class="conversation-item text-muted @(selectedUser?.Id == user.Id ? "active" : "")"
                                         @onclick="() => SelectUser(user)">

                                        <div class="conversation-avatar">
                                            @user.FullName[0]
                                        </div>

                                        <div class="conversation-details">
                                            <span class="conversation-name">@user.FullName</span>
                                            <small>Offline</small>
                                        </div>
                                    </div>
                                }
                            </div>

                        </div>

                        break;

                    case SidebarSection.Groups:
                        <div class="px-2">

                            @if (groups.Count == 0)
                            {
                                <p class="text-muted small text-center">No groups yet 🚧</p>
                            }
                            else
                            {
                                @foreach (var group in groups)
                                {
                                    <div class="conversation-item @(CurrentGroupId == group.Id ? "active" : "")"
                                         @onclick="() => SelectGroup(group)">

                                        <!-- Avatar -->
                                        <div class="conversation-avatar">
                                            @(group.Name.Split(' ').Select(n => n[0]).FirstOrDefault())
                                        </div>

                                        <!-- Details -->
                                        <div class="conversation-details">
                                            <div class="conversation-header">
                                                <span class="conversation-name">@group.Name</span>

                                                @if (group.LastMessageTime != null)
                                                {
                                                    <span class="conversation-time">
                                                        @FormatMessageTime(@group.LastMessageTime.Value)
                                                    </span>
                                                }
                                            </div>

                                            <div class="conversation-preview">
                                                @(!string.IsNullOrEmpty(group.LastMessage)
                                                    ? group.LastMessage
                                                    : "No messages yet")
                                            </div>

                                            <small class="text-muted small opacity-75">
                                                @group.MembersCount members
                                            </small>

                                        </div>

                                        <!-- DROPDOWN -->
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-light border-0"
                                                    data-bs-toggle="dropdown"
                                                    @onclick:stopPropagation="true">
                                                ⋮
                                            </button>

                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <button class="dropdown-item"
                                                            @onclick="() => OpenGroupInfo(group)">
                                                        👥 Group Info
                                                    </button>

                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                }
                            }
                        </div>
                        break;

                }

            </div>


        </div>

    </div>

    @if (loading)
    {
        <p class="mt-5 text-center">Loading...</p>
    }
    else if (!string.IsNullOrEmpty(initError))
    {
        <p style="color:red">@initError</p>
    }
    else
    {

        <div class="d-flex flex-column h-100" style="width:100%">
            @* message selection buttons   *@

            @if (isSelectionMode)
            {
                <div class="d-flex justify-content-end align-items-center gap-2 bg-light">
                    <span class="text-muted small mt-1">
                        @selectedMessageIds.Count selected
                    </span>

                    <button class="btn btn-outline-danger btn-sm mt-1 mb-1"
                            disabled="@(!selectedMessageIds.Any())"
                            @onclick="DeleteSelectedMessages">
                        🗑 Delete
                    </button>

                    <button class="btn btn-sm btn-outline-primary mt-1 mb-1 me-1"
                            @onclick="ClearSelection">
                        ✖ Cancel
                    </button>
                </div>
            }

            @* This is group info ui Start.......................... *@
            @if (showGroupInfo)
            {
                <!-- Overlay (Click to close) -->
                <div class="overlay active"></div>

                <div class="group-info-panel open">
                    <!-- Header -->
                    <div class="group-info-header">
                        <h5>Group Info</h5>
                        <button class="close-btn" @onclick="() => showGroupInfo = false">✖</button>
                    </div>

                    <!-- Group Avatar & Name -->
                    <div class="group-avatar-section">
                        <div class="group-avatar-large">
                            @groupInfo.Name.Substring(0, Math.Min(3, groupInfo.Name.Length)).ToUpper()
                        </div>
                        <div class="group-name">@groupInfo.Name</div>
                        <div class="group-created">
                            Created on @groupInfo.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                        </div>
                    </div>

                    <!-- Body Content -->
                    <div class="group-info-body">
                        <!-- Stats -->
                        <div class="info-section">
                            <div class="group-stats">
                                <div class="stat-card">
                                    <span class="stat-number">@groupInfo.MembersCount</span>
                                    <span class="stat-label">Members</span>
                                </div>
                                <!-- You can fetch total messages if needed -->
                                <div class="stat-card">
                                    <span class="stat-number">@groupInfo.MessagesCount</span>
                                    <span class="stat-label">Messages</span>
                                </div>
                            </div>
                        </div>

                        <!-- Members -->
                        <div class="info-section">
                            <div class="section-header">
                                <span class="section-title">Members</span>
                                <span class="member-count">@groupInfo.Members.Count</span>
                            </div>
                            <ul class="member-list">
                                @foreach (var member in groupInfo.Members)
                                {
                                    <li class="member-item">
                                        <div class="avatar">
                                            @member.Username.Substring(0, 2).ToUpper() <!-- or use actual initials -->
                                        </div>
                                        <div class="member-details">
                                            <span class="member-name">@member.Username</span> <!-- Replace with actual username if you have it -->
                                            <span class="member-role">@((member.IsAdmin) ? "Group Admin" : "Member")</span>
                                        </div>
                                        @if (member.IsAdmin)
                                        {
                                            <span class="admin-badge">Admin</span>
                                        }
                                        else
                                        {
                                            <!-- Online / Offline indicator -->
                                            <div class=" @(member.IsOnline ? "online-indicator" : "Offline")"></div>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="action-buttons">
                        <button type="button" class="action-btn btn-add-member"
                                @onclick="OpenAddMemberModal">
                            <span>➕</span> Add Member
                        </button>

                        <button class="action-btn btn-leave"
                                @onclick="LeaveGroup">
                            <span>🚪</span> Leave
                        </button>
                    </div>
                </div>

                <!-- end group-info-panel -->
                @if (showAddMemberModal)
                {
                    <div class="modal-backdrop" @onclick="() => showAddMemberModal = false"></div>

                    <div class="add-member-modal">
                        <h4>Add member</h4>

                        @if (!users.Any(u => !groupInfo.Members.Any(m => m.UserId == u.Id)))
                        {
                            <p class="text-muted">All users are already members 🎉</p>
                        }
                        else
                        {
                            <select @bind="selectedUserId">
                                @foreach (var user in users
                               .Where(u => !groupInfo.Members.Any(m => m.UserId == u.Id)))
                                {
                                    <option value="@user.Id">@user.FullName</option>
                                }
                            </select>
                        }


                        <div class="modal-actions">
                            <button type="button" @onclick="AddMember">Add</button>
                            <button type="button" @onclick="() => showAddMemberModal = false">Cancel</button>
                        </div>
                    </div>
                }

            }
            @* This is group info ui End.......................... *@

            <!-- CHAT AREA -->
            <!-- MAIN CONTENT -->
            <div class="flex-grow-1 d-flex align-items-center justify-content-center bg-light">

                @if (selectedUser == null && selectedGroup == null)
                {
                    <!-- EMPTY STATE -->
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center py-5">
                        <div class="bg-light rounded-circle p-4">
                            <i class="bi bi-chat-dots text-primary" style="font-size: 3rem;"></i>
                        </div>
                        <h2 class="fw-bold">Your Messages</h2>
                        <p class="text-muted mb-4" style="max-width: 250px;">
                            Select a conversation from the sidebar to start chatting with your friends or groups.
                        </p>
                        <button class="btn btn-outline-primary btn-sm rounded-pill px-4
                            @(activeSection == SidebarSection.OnlineUsers ? "active" : "")"
                                @onclick="() => activeSection = SidebarSection.OnlineUsers">
                            <i class="bi bi-plus-lg me-2"></i>New Conversation
                        </button>
                    </div>


                }
                else
                {
                    <!-- CHAT AREA -->
                    <div class="bg-white border rounded p-3 d-flex flex-column chat-container">

                        <button class="btn btn-sm btn-light d-md-none"
                                @onclick="() => { selectedUser = null; selectedGroup = null; }">
                            ← Back
                        </button>
                        @* ================= USER CHAT ================= *@
                        @if (selectedUser != null)
                        {
                            <!-- HEADER -->
                            <div class="chat-header-fancy">
                                <div class="chat-user-avatar">
                                    @(selectedUser.FullName.Split(' ').Select(n => n[0]).FirstOrDefault())
                                </div>
                                <div>
                                    <h5 class="mb-0">@selectedUser.FullName</h5>
                                    <small class="text-muted">
                                        @(selectedUser.IsOnline ? "Online" : "Offline")
                                    </small>
                                </div>
                            </div>

                            <!-- MESSAGES -->
                            <div class="flex-grow-1 border rounded p-2 mb-2 overflow-auto">
                                @foreach (var msg in messages)
                                {
                                    var isSent = msg.SenderId.ToString() == currentUserId;
                                    var isSelected = selectedMessageIds.Contains(msg.Id);

                                    <div class="message-wrapper @(isSent ? "sent-wrap" : "received-wrap")"
                                         @onclick="() => OnMessageClick(msg.Id)">

                                        <div class="chat-message @(isSent ? "sent" : "received") @(isSelected ? "selected" : "")">
                                            <strong>@(isSent ? "You" : selectedUser.FullName)</strong>
                                            <span class="message-text">@msg.Content</span>

                                            @if (isSelected)
                                            {
                                                <span class="selection-tick">✔</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @* ================= GROUP CHAT ================= *@
                        else if (selectedGroup != null)
                        {
                            <!-- HEADER -->
                            <div class="chat-header-fancy">
                                <div class="chat-user-avatar">
                                    @(selectedGroup.Name.Split(' ').Select(n => n[0]).FirstOrDefault())
                                </div>
                                <div>
                                    <small class="text-muted">Group</small>
                                    <h5 class="mb-0">@selectedGroup.Name</h5>
                                    <small class="text-muted">
                                        @selectedGroup.MembersCount members
                                    </small>
                                </div>
                            </div>

                            <!-- MESSAGES -->
                            <div class="flex-grow-1 border rounded p-2 mb-2 overflow-auto">
                                @foreach (var msg in groupMessages)
                                {
                                    var isSent = msg.SenderId.ToString() == currentUserId;
                                    var isSelected = selectedMessageIds.Contains(msg.Id);

                                    <div class="message-wrapper @(isSent ? "sent-wrap" : "received-wrap")"
                                         @onclick="() => OnMessageClick(msg.Id)">

                                        <div class="chat-message @(isSent ? "sent" : "received") @(isSelected ? "selected" : "")">
                                            <strong>@(isSent ? "You" : GetUserName(msg.SenderId))</strong>
                                            <span class="message-text">@msg.Content</span>

                                            @if (isSelected)
                                            {
                                                <span class="selection-tick">✔</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                        }

                        <!-- INPUT -->
                        <div class="d-flex gap-2 chat-input-area">
                            <input class="form-control chat-input"
                                   placeholder="Type a message..."
                                   @bind="newMessage" />

                            <button class="btn btn-secondary chat-send-btn"
                                    @onclick="Send">
                                Send
                            </button>
                        </div>
                    </div>

                }

            </div>

        </div>        

    }
</div>

@code {
    List<UserDto> users = new();
    string? currentUserId;
    string? token;
    bool loading = true;
    string? initError;
    List<MessageDto> messages = new();
    UserDto? selectedUser;
    UserDto? CurrentUser { get; set; }
    enum SidebarSection
    {
        Conversations,
        OnlineUsers,
        Groups
    }
    SidebarSection activeSection = SidebarSection.Conversations;

    private string CurrentUserInitials => CurrentUser == null ? "NA"
    : string.Concat(CurrentUser.FullName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(n => n[0])
    ).ToUpper();

    string newMessage = "";
    List<ConversationDto>? conversations { get; set; }
    ConversationDto? selectedConversation;
    bool isMiniSidebarExpanded = false;
    bool isSelectionMode = false;

    HashSet<Guid> selectedMessageIds = new();
    List<GroupDto> groups = new();
    List<GroupMessageDto> groupMessages = new();
    string newGroupName = "";
    List<Guid> newGroupMembers = new(); // for modal multiselect
    bool showCreateGroupModal = false;
    Guid? CurrentGroupId; // currently selected group
    GroupDto? selectedGroup;
    bool showGroupInfo = false;
    GroupInfoDto? groupInfo;
    bool showAddMemberModal = false;
    Guid selectedUserId;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        loading = true;
        try
        {
            token = await AuthProvider.GetTokenAsync();
            currentUserId = await AuthProvider.GetUserIdAsync();


            if (string.IsNullOrEmpty(token) || string.IsNullOrEmpty(currentUserId))
            {
                initError = "Authentication failed.";
                return;
            }

            // Fetch users with online status from backend
            var userRequests = await MessageService.GetOnlineUsersAsync(); // new method
            if (userRequests == null)
            {
                initError = "Failed to load users.";
                return;
            }

            var user = userRequests.FirstOrDefault(u => u.Id.ToString() == currentUserId);

            if (user != null)
            {
                CurrentUser = new UserDto
                    {
                        FullName = user.FullName,
                        IsOnline = true // current user is online once connected
                    };
            }

            users = userRequests
                .Where(u => u.Id.ToString() != currentUserId) // exclude self
                .ToList();

            // Getting Conversations
            conversations = await MessageService.GetConversationAsync();

            // Load groups for current user
            groups = await GroupService.GetGroupsAsync();

            // Connect SignalR AFTER fetching users
            await Hub.ConnectAsync(token, Nav);

            // Subscribe to hub events
            Hub.MessageReceived += OnMessageReceived;

            Hub.GroupMessageReceived += OnGroupMessageReceived;


            Hub.UserOnline += userId =>
            {
                var u = users.FirstOrDefault(x => x.Id.ToString() == userId);
                if (u != null) u.IsOnline = true;
                InvokeAsync(StateHasChanged);
            };

            Hub.UserOffline += userId =>
            {
                var u = users.FirstOrDefault(x => x.Id.ToString() == userId);
                if (u != null) u.IsOnline = false;
                InvokeAsync(StateHasChanged);
            };

            Hub.SetOnlineUsers += ids =>
            {
                foreach (var u in users)
                    u.IsOnline = ids.Contains(u.Id.ToString());
                InvokeAsync(StateHasChanged);
            };
        }
        catch (Exception ex)
        {
            initError = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    string GetUserName(Guid senderId)
    {
        var user = users.FirstOrDefault(u => u.Id == senderId);
        return user?.FullName ?? "Unknown";
    }


    void ToggleMiniSidebar()
    {
        isMiniSidebarExpanded = !isMiniSidebarExpanded;
    }

    async Task SelectUser(UserDto user)
    {
        selectedUser = user;
        selectedConversation = null;
        selectedGroup = null;
        CurrentGroupId = null;

        try
        {
            messages = await MessageService.GetChatAsync(user.Id);
        }
        catch (Exception ex)
        {
            initError = $"Error fetching messages: {ex.Message}";
        }

        StateHasChanged();
    }

    async Task SelectConversation(ConversationDto convo)
    {
        // 🔥 CLEAR GROUP STATE
        selectedGroup = null;
        CurrentGroupId = null;

        // 🔥 CLEAR SELECTION MODE
        selectedMessageIds.Clear();
        isSelectionMode = false;
        selectedConversation = convo;

        // 🔥 Sync selectedUser from conversation
        selectedUser = users.FirstOrDefault(u => u.Id == convo.UserId)
                       ?? new UserDto
                           {
                               Id = convo.UserId,
                               FullName = convo.FullName
                           };

        messages = await MessageService.GetChatAsync(convo.UserId);

        StateHasChanged();
    }

    async Task Send()
    {
        if (string.IsNullOrWhiteSpace(newMessage))
            return;

        if (selectedUser != null)
        {
            var msgText = newMessage;
            var now = DateTime.UtcNow;

            await Hub.SendMessageAsync(selectedUser.Id.ToString(), msgText);

            // 🔥 UPDATE SIDEBAR
            UpdateConversationPreview(
                selectedUser.Id,
                msgText,
                now
            );
        }

        else if (selectedGroup != null)
        {
            var msgText = newMessage;
            var now = DateTime.UtcNow;

            await Hub.SendGroupMessageAsync(
                selectedGroup.Id,
                Guid.Parse(currentUserId!),
                msgText
            );

            // 🔥 UPDATE SIDEBAR IMMEDIATELY
            UpdateGroupConversationPreview(
                selectedGroup.Id,
                msgText,
                now
            );
        }

        newMessage = "";
        StateHasChanged();
    }


    void OnMessageReceived(MessageDto msg)
    {
        var otherUserId =
            msg.SenderId.ToString() == currentUserId
                ? msg.ReceiverId
                : msg.SenderId;

        if (selectedUser != null && selectedUser.Id == otherUserId)
        {
            messages.Add(msg);
        }

        // 🔥 ALWAYS update sidebar
        UpdateConversationPreview(
            otherUserId,
            msg.Content,
            msg.CreatedAt
        );

        InvokeAsync(StateHasChanged);
    }

    async Task OpenGroupInfo(GroupDto group)
    {
        selectedGroup = group;

        // fetch full group info from backend
        groupInfo = await GroupService.GetGroupInfoAsync(group.Id);

        showGroupInfo = true;
    }


    void OnGroupMessageReceived(GroupMessageDto msg)
    {
        if (selectedGroup != null && msg.GroupId == selectedGroup.Id)
        {
            groupMessages.Add(msg);

        }
        // 🔥 ALWAYS update sidebar
        UpdateGroupConversationPreview(
            msg.GroupId,
            msg.Content,
            msg.SentAt
        );

        InvokeAsync(StateHasChanged);
    }

    void OnMessageClick(Guid messageId)
    {
        ToggleMessageSelection(messageId);

        // Auto-enable selection mode
        isSelectionMode = selectedMessageIds.Any();
    }

    void ToggleMessageSelection(Guid messageId)
    {
        if (selectedMessageIds.Contains(messageId))
            selectedMessageIds.Remove(messageId);
        else
            selectedMessageIds.Add(messageId);

        // Auto-exit selection mode
        isSelectionMode = selectedMessageIds.Any();
    }

    void ClearSelection()
    {
        selectedMessageIds.Clear();
        isSelectionMode = false;
    }

    async Task DeleteSelectedMessages()
    {
        if (!selectedMessageIds.Any())
            return;

        bool confirmed = await DialogService.ConfirmAsync(new MessageBoxOptions()
            {
                Title = "Confirm Action",
                Text = "Are you sure you want to the message/s?",
                RenderStyle = MessageBoxRenderStyle.Warning,
                OkButtonText = "Delete",
                CancelButtonText = "Cancel"
            });

        if (!confirmed) return;

        Console.WriteLine($"Deleting private messages: {string.Join(",", selectedMessageIds)}");

        bool success;

        if (selectedGroup != null)
        {
            // ✅ GROUP CHAT DELETE
            success = await GroupMessageService
                .DeleteGroupMessagesAsync(selectedMessageIds);

            if (success)
            {
                groupMessages.RemoveAll(
                    m => selectedMessageIds.Contains(m.Id)
                );

                ToastService.ShowToast(new ToastOptions
                    {
                        Title = "Success!",
                        Text = "Message Deleted successfully.",
                        RenderStyle = ToastRenderStyle.Success,
                        DisplayTime = TimeSpan.FromSeconds(5),
                        ThemeMode = ToastThemeMode.Pastel
                    });

                // 🔥 RECALCULATE LAST MESSAGE CORRECTLY
                var lastMsg = groupMessages
                    .OrderByDescending(m => m.SentAt)
                    .FirstOrDefault();


                UpdateGroupConversationPreview(
                    selectedGroup.Id,
                    lastMsg?.Content,
                    lastMsg?.SentAt
                );

            }
        }
        else
        {
            // ✅ PRIVATE CHAT DELETE
            success = await MessageService
                .DeleteMessagesAsync(selectedMessageIds);

            if (success)
                messages.RemoveAll(m => selectedMessageIds.Contains(m.Id));

            ToastService.ShowToast(new ToastOptions
                {
                    Title = "Success!",
                    Text = "Message Deleted successfully.",
                    RenderStyle = ToastRenderStyle.Success,
                    DisplayTime = TimeSpan.FromSeconds(5),
                    ThemeMode = ToastThemeMode.Pastel
                });

            var lastMsg = messages
                .OrderByDescending(m => m.CreatedAt)
                .FirstOrDefault();

            if (lastMsg != null)
            {
                UpdateConversationPreview(
    selectedUser!.Id,
    lastMsg?.Content,
    lastMsg.CreatedAt
            );
            }
        }

        if (!success)
        {
            initError = "Failed to delete messages.";
            return;
        }

        // reset state
        selectedMessageIds.Clear();
        isSelectionMode = false;

        StateHasChanged();
    }

    void UpdateGroupConversationPreview(Guid groupId, string? lastMessage, DateTime? time)
    {
        var group = groups.FirstOrDefault(g => g.Id == groupId);

        // ✅ SAFETY: group must exist
        if (group == null) return;

        group.LastMessage = lastMessage;
        group.LastMessageTime = time;

        groups = groups
            .OrderByDescending(g => g.LastMessageTime ?? DateTime.MinValue)
            .ToList();

        InvokeAsync(StateHasChanged);
    }


    void UpdateConversationPreview(Guid otherUserId, string? lastMessage, DateTime time)
    {
        if (conversations == null)
            conversations = new List<ConversationDto>();

        var convo = conversations.FirstOrDefault(c => c.UserId == otherUserId);

        // CREATE conversation if it doesn't exist
        if (convo == null)
        {
            var user = users.FirstOrDefault(u => u.Id == otherUserId);

            convo = new ConversationDto
                {
                    UserId = otherUserId,
                    FullName = user?.FullName ?? "Unknown",
                    LastMessage = lastMessage,
                    LastMessageTime = time,
                    UnreadCount = 0
                };

            conversations.Add(convo);
        }
        else
        {
            convo.LastMessage = lastMessage;
            convo.LastMessageTime = time;
        }

        // 🔥 Move to top
        conversations = conversations
            .OrderByDescending(c => c.LastMessageTime)
            .ToList();

        InvokeAsync(StateHasChanged);
    }


    void OpenAddMemberModal()
    {
        showAddMemberModal = true;
    }

    async Task AddMember()
    {
        var success = await GroupService.AddMemberAsync(
            groupInfo.Id,
            selectedUserId
        );

        if (!success)
            return;

        showAddMemberModal = false;

        ToastService.ShowToast(new ToastOptions
            {
                Title = "Success!",
                Text = "Member Added successfully.",
                RenderStyle = ToastRenderStyle.Success,
                DisplayTime = TimeSpan.FromSeconds(5),
                ThemeMode = ToastThemeMode.Pastel
            });

        groupInfo = await GroupService.GetGroupInfoAsync(groupInfo.Id);

        // ✅ UPDATE SIDEBAR COUNT
        var groupInList = groups.FirstOrDefault(g => g.Id == groupInfo.Id);
        if (groupInList != null)
        {
            groupInList.MembersCount = groupInfo.MembersCount;
        }

        StateHasChanged();
    }

    private async Task LeaveGroup()
    {
        if (CurrentGroupId == null) return;

        bool confirmed = await DialogService.ConfirmAsync(new MessageBoxOptions()
            {
                Title = "Confirm Action",
                Text = "Are you sure you want to leave this group?",
                RenderStyle = MessageBoxRenderStyle.Warning,
                OkButtonText = "Leave",
                CancelButtonText = "Cancel"
            });

        if (!confirmed) return;

        var success = await GroupService.LeaveGroupAsync(CurrentGroupId.Value);

        if (success)
        {
            groups.RemoveAll(g => g.Id == CurrentGroupId);

            // 🔥 CLEAR CHAT STATE
            selectedGroup = null;
            CurrentGroupId = null;
            groupMessages.Clear();

            ToastService.ShowToast(new ToastOptions
                {
                    Title = "Group",
                    Text = "Left group successfully.",
                    RenderStyle = ToastRenderStyle.Success,
                    DisplayTime = TimeSpan.FromSeconds(5),
                    ThemeMode = ToastThemeMode.Pastel
                });

            StateHasChanged();
        }
    }

    private async Task DeleteConversation(Guid otherUserId)
    {
        bool confirmed = await DialogService.ConfirmAsync(new MessageBoxOptions()
            {
                Title = "Confirm Action",
                Text = "Are you sure you want to delete this conversation?",
                RenderStyle = MessageBoxRenderStyle.Warning,
                OkButtonText = "Delete",
                CancelButtonText = "Cancel"
            });

        if (!confirmed) return;

        var success = await MessageService.DeleteConversationAsync(otherUserId);
        if (success)
        {
            // Remove locally
            conversations.RemoveAll(c => c.UserId == otherUserId);
            StateHasChanged();

            ToastService.ShowToast(new ToastOptions
                {
                    Title = "Success!",
                    Text = "Conversation Deleted successfully.",
                    RenderStyle = ToastRenderStyle.Success,
                    DisplayTime = TimeSpan.FromSeconds(5),
                    ThemeMode = ToastThemeMode.Pastel
                });

            // Reset chat if this was selected
            if (selectedUser?.Id == otherUserId)
                selectedUser = null;
        }
    }

    private async Task Logout()
    {
        // 🔥 1. Disconnect SignalR
        await Hub.DisconnectAsync();

        // 2. Remove token
        await JS.InvokeVoidAsync("deleteCookie", "access_token");

        // 3. Update auth state
        if (AuthProvider is JWTAuthenticationStateProvider jwtAuth)
        {
            jwtAuth.MarkAsUnauthorize();
        }

        // 4. Redirect
        Nav.NavigateTo("/login", true);
    }

    async Task SelectGroup(GroupDto group)
    {
        // Leave previous group if any
        if (selectedGroup != null)
            await Hub.LeaveGroupAsync(selectedGroup.Id);

        selectedGroup = group;
        CurrentGroupId = group.Id;
        selectedUser = null;
        selectedConversation = null;

        // Join the new group
        await Hub.JoinGroupAsync(group.Id);

        // Load existing messages
        groupMessages = await GroupMessageService.GetGroupMessagesAsync(group.Id);

        StateHasChanged();
    }

    public static string FormatMessageTime(DateTime sentAt)
    {
        var now = DateTime.Now;
        var sent = sentAt.ToLocalTime(); // make sure to convert from UTC if needed

        var diff = now.Date - sent.Date;

        if (diff.Days == 0)
        {
            // Today → show only time
            return sent.ToString("HH:mm"); // e.g., 14:35
        }
        else if (diff.Days == 1)
        {
            // Yesterday
            return "Yesterday";
        }
        else if (diff.Days < 7)
        {
            // Within last week → show day of the week
            return sent.ToString("dddd"); // e.g., Monday
        }
        else
        {
            // Older → show date
            return sent.ToString("dd/MM/yyyy"); // or "MMM dd, yyyy"
        }
    }


}
