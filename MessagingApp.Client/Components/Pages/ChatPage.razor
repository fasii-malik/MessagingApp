    private async void StartTypewriterEffect(MessageDto message)
    {
        // Stop any existing typewriter animation
        typewriterTimer?.Dispose();

        isTypewriting = true;
        typewriterIndex = 0;
        typewritingMessageId = message.Id;

        // Check if message already exists (to avoid duplicates)
        var existingMsg = messages.FirstOrDefault(m => m.Id == message.Id);

        if (existingMsg == null)
        {
            // Add a placeholder message with empty content
            var typingMessage = new MessageDto
                {
                    Id = message.Id,
                    SenderId = message.SenderId,
                    ReceiverId = message.ReceiverId,
                    Content = "",
                    CreatedAt = message.CreatedAt
                };
            messages.Add(typingMessage);
        }
        else
        {
            // Clear existing content for animation
            existingMsg.Content = "";
        }

        await InvokeAsync(StateHasChanged);

        // Start typing animation
        string fullContent = message.Content;
        int speed = 5; // milliseconds per character - lower = faster
        string currentContent = ""; // Local variable for this animation

        _ = Task.Run(async () =>
        {
            for (int i = 0; i < fullContent.Length; i++)
            {
                currentContent += fullContent[i]; // Build content character by character

                // Update the message content
                var msg = messages.FirstOrDefault(m => m.Id == message.Id);
                if (msg != null)
                {
                    msg.Content = currentContent; // Use local variable instead of typewriterContent
                }

                await InvokeAsync(StateHasChanged);

                // Scroll every few characters for better performance
                if (i % 5 == 0 || i == fullContent.Length - 1)
                {
                    await ScrollToBottom();
                }

                await Task.Delay(speed);
            }

            // Typing complete
            isTypewriting = false;
            typewritingMessageId = null;
            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();
        });
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await JS.InvokeVoidAsync("scrollToBottom", "chatMessages");
            });
