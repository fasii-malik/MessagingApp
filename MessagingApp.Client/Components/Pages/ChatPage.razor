    private async Task TogglePin(ConversationDto convo)
    {
        bool success;

        if (convo.IsPinned)
            success = await MessageService.UnpinConversationAsync(convo.UserId);
        else
            success = await MessageService.PinConversationAsync(convo.UserId);

        if (!success)
            return;

        convo.IsPinned = !convo.IsPinned;

        // Optional: re-sort locally for instant UX
        conversations = conversations
            .OrderByDescending(c => c.IsPinned)
            .ThenByDescending(c => c.LastMessageTime)
            .ToList();
    }

    async Task ToggleGroupPin(GroupDto group)
    {
        if (group.IsPinned)
            await GroupService.UnpinGroupAsync(group.Id);
        else
            await GroupService.PinGroupAsync(group.Id);

        group.IsPinned = !group.IsPinned;

        groups = groups
            .OrderByDescending(g => g.IsPinned)
            .ThenByDescending(g => g.LastMessageTime ?? DateTime.MinValue)
            .ToList();
    }

